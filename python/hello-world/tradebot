        raise
    time.sleep(1)

df_all = df_all.reset_index(level=0, drop=True)
df_all.index = df_all.index.tz_convert("America/New_York")
df_all = df_all.between_time("09:30", "16:00")

data = df_all.rename(columns={"close": "Close", "volume": "Volume"})
df = pd.DataFrame({"close": data["Close"]})
df["prev_close"] = df["close"].shift(1)
df["volume"] = data["Volume"]
df["ma5"] = df["close"].rolling(window=5).mean()
df["volatility"] = df["close"].rolling(window=5).std()
df["rsi"] = calculate_rsi(df["close"], periods=7)
df["target"] = (df["close"] > df["prev_close"]).astype(int)
df.dropna(inplace=True)

X = df[["prev_close", "volume", "ma5", "volatility", "rsi"]]
y = df["target"]

scaler = MinMaxScaler()
X_np = scaler.fit_transform(X)
y_np = y.to_numpy()

model = LogisticRegression(random_state=42, max_iter=1000)
