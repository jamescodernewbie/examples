# Fully automated: Wait for market open, stop at close
print("Waiting for market open...")
MARKET_OPEN_CET = pd.Timestamp("2025-02-24 15:30:00", tz="Europe/Copenhagen")  # 3:30 PM CET
MARKET_CLOSE_CET = pd.Timestamp("2025-02-24 22:00:00", tz="Europe/Copenhagen")  # 10:00 PM CET

while datetime.now(timezone.utc) < MARKET_OPEN_CET.astimezone(timezone.utc):
    print(f"{datetime.now(timezone.utc)}: Still waiting - Market opens at {MARKET_OPEN_CET}")
    time.sleep(60)

print(f"Starting live trading with Alpaca at {datetime.now()}")
cash = 100000.0
shares = 0
trade_log = []

while datetime.now(timezone.utc) < MARKET_CLOSE_CET.astimezone(timezone.utc):
    try:
        request = StockBarsRequest(symbol_or_symbols=SYMBOL, timeframe=TimeFrame.Minute, limit=8)
        bars = data_client.get_stock_bars(request).df
        if bars.empty:
            print(f"{datetime.now()}: No bars fetched—market may be closed")
            time.sleep(60)
            continue

        timestamps = bars.index.get_level_values(1).tz_convert("America/New_York")
        latest_time = timestamps[-1].time()
        if not (latest_time >= pd.Timestamp("09:30").time() and latest_time <= pd.Timestamp("16:00").time()):
            print(f"{datetime.now()}: Outside trading hours ({latest_time})—waiting")
            time.sleep(60)
            continue

        latest_bar = bars.iloc[-1]
        latest_data = pd.DataFrame({
            "close": [latest_bar["close"]],
            "prev_close": [bars.iloc[-2]["close"]],
            "volume": [latest_bar["volume"]],
            "ma5": [bars["close"][-5:].mean()],
            "volatility": [bars["close"][-5:].std()],
            "rsi": [calculate_rsi(bars["close"])[-1]]
        })
        latest_np = scaler.transform(latest_data[["prev_close", "volume", "ma5", "volatility", "rsi"]])

        prediction = model.predict(latest_np)[0]
        signal = "BUY" if prediction == 1 else "SELL"
        price = latest_bar["close"]
        print(f"{datetime.now()}: Price = ${price:.2f}, Signal = {signal}, Shares = {shares}, Cash = ${cash:.2f}")

        order = MarketOrderRequest(symbol=SYMBOL, qty=QTY, time_in_force=TimeInForce.GTC)
        if signal == "BUY" and cash >= price * QTY:
            order.side = OrderSide.BUY
            trading_client.submit_order(order)
            shares += QTY
            cash -= price * QTY
            trade_log.append(f"BUY: {QTY} shares at ${price:.2f}, {datetime.now()}")
            print(f"BUY: {QTY} shares at ${price:.2f}, Shares = {shares}, Cash = ${cash:.2f}")
        elif signal == "SELL" and shares >= QTY:
            order.side = OrderSide.SELL
            trading_client.submit_order(order)
            shares -= QTY
            cash += price * QTY
            trade_log.append(f"SELL: {QTY} shares at ${price:.2f}, {datetime.now()}")
            print(f"SELL: {QTY} shares at ${price:.2f}, Shares = {shares}, Cash = ${cash:.2f}")

        total_value = cash + shares * price
        print(f"Total Value = ${total_value:.2f} (+{((total_value - 100000) / 100000 * 100):.2f}%)")
        time.sleep(60)  # 1 trade/min—adjusted to ~42 trades/min

    except Exception as e:
        print(f"Error during live trading: {e}")
        time.sleep(60)

print(f"{datetime.now()}: Market closed—stopping trading")
with open("trade_log.txt", "w") as f:
    f.write("\nTrade Log:\n")
    for entry in trade_log:
